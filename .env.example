# --- Postgres / Redis (used by docker-compose.yml directly) ---
POSTGRES_PASSWORD=changeme
REDIS_PASSWORD=changeme
DATABASE_URL=postgresql://espada:changeme@postgres:5432/espada
REDIS_URL=redis://:changeme@redis:6379

# --- Clerk (already wired into the frontend) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# --- LLM providers ---
GROQ_API_KEY=
OPENAI_API_KEY=

# --- File storage (local disk on the VPS) ---
UPLOADS_DIR=/app/uploads

# --- Domain (used by Caddy) ---
DOMAIN=yourdomain.com

# --- Error tracking ---
SENTRY_DSN=

# --- Razorpay (leave blank until billing is wired up) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_MONTHLY=
RAZORPAY_PLAN_ANNUALLY=
